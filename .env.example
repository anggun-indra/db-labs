# Database Learning Lab - environment template
#
# Copy this file to `.env` (or `.env.local`) and fill in values from the
# Firebase console: Project settings -> General -> Your apps -> SDK setup.
#
# The Firebase *public web config* is safe to expose in the frontend (this is
# how Firebase is designed). Real security is enforced through Firebase Auth
# and Firestore Security Rules - see SECURITY.md.
#
# Phase 0/1 of the app runs fully without Firebase configured; the app
# detects missing values and stays in local-only mode.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
