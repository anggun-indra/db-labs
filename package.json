{
  "name": "database-learning-lab",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "description": "Database Learning Lab - a local-first React PWA for learning database management through hands-on ERD design and SQL practice.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rules": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 vitest run firestoreRules",
    "icons": "node scripts/generate-icons.mjs",
    "emulators": "bash scripts/emulators.sh",
    "seed:demo": "node scripts/seed-demo.mjs",
    "gates": "bash scripts/gates.sh",
    "dev:emulators": "concurrently \"npm run dev\" \"npm run serve:emulators\"",
    "visual": "node scripts/visual-snapshots.mjs",
    "deploy": "firebase deploy",
    "start": "vite preview",
    "serve:emulators": "firebase emulators:start --project demo-dblab"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.3.5",
    "antd": "^5.21.6",
    "firebase": "^11.0.1",
    "monaco-editor": "^0.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sql.js": "^1.14.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.48.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^10.0.5",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.4"
  }
}