// Database Learning Lab — Firestore security rules (Phase 6+).
// Principles (spec §28, §35, §39):
//  - Firebase UID is the canonical identity; no anonymous writes.
//  - Students own their projects: CRUD only on documents where
//    ownerUid == request.auth.uid.
//  - Roles are granted server-side: a client can only CREATE its own user
//    document with role 'student', and can never change the role field
//    afterwards (lecturer grants happen out-of-band in the console/API).
rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Authoritative lecturer check used by courses/assignments/submissions.
    function isLecturer() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'lecturer'
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Super Admin & Lecturer check for free-tier quota monitoring, user management and storage cleanup.
    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'lecturer');
    }


    match /users/{uid} {
      // A user may read and update their own profile, but the role field
      // is frozen after creation (server-side role enforcement).
      // Super Admins have full management access (create, promote, update, delete).
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if signedIn()
        && ((request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.role == 'student')
            || isSuperAdmin());
      allow update: if signedIn()
        && ((request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.role == resource.data.role)
            || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /projects/{projectId} {
      allow read, delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isSuperAdmin());
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.projectId == projectId;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
    }

    // SQLite snapshots (Phase 5): metadata document + chunks subcollection.
    // Snapshots are immutable: create once, delete whole — never update.
    // Chunk access inherits ownership from the parent metadata document.
    match /sqliteSnapshots/{snapshotId} {
      allow read, delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isSuperAdmin());
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.snapshotId == snapshotId;
      allow update: if false;

      match /chunks/{chunkIndex} {
        allow read, write, delete: if signedIn()
          && (get(/databases/$(database)/documents/sqliteSnapshots/$(snapshotId)).data.ownerUid == request.auth.uid || isSuperAdmin());
      }
    }

    // Courses (Phase 6): readable by any signed-in user, managed by course owner (or super admin).
    match /courses/{courseId} {
      allow read: if signedIn();
      allow create: if isLecturer()
        && request.resource.data.lecturerUid == request.auth.uid;
      allow update: if (isLecturer() && resource.data.lecturerUid == request.auth.uid && request.resource.data.lecturerUid == request.auth.uid)
        || isSuperAdmin();
      allow delete: if (isLecturer() && resource.data.lecturerUid == request.auth.uid) || isSuperAdmin();
    }

    // Course memberships (enrollments) (Phase 6+). Students join automatically,
    // lecturers manage roles manually. Readable by members only.
    match /courseMemberships/{membershipId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.uid || isSuperAdmin());
      
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'student';
      
      allow update: if signedIn()
        && (request.auth.uid == resource.data.uid || isSuperAdmin());
      
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.uid || isSuperAdmin());
    }

    // Assignments (Phase 6+): students read published only; lecturers manage
    // their own. Drafts/archived never leak to students because the read
    // rule requires status == 'published' for non-lecturers.
    match /assignments/{assignmentId} {
      allow read: if signedIn()
        && (isLecturer() || resource.data.status == 'published');
      allow create: if isLecturer()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.assignmentId == assignmentId;
      allow update, delete: if (isLecturer() && resource.data.createdByUid == request.auth.uid) || isSuperAdmin();
    }

    // Task progress (Phase 6+): private per student-task relationship.
    // Students can record progress on their own tasks; lecturers read all tasks
    // for their courses. Progress data is immutable except for status updates.
    match /taskProgress/{progressId} {
      allow read: if signedIn()
        && (isLecturer()
            || resource.data.uid == request.auth.uid);
      
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      
      allow update: if signedIn()
        && ((resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentStep', 'completedAt']))
            || (isLecturer() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'feedback', 'graded'])));
      
      allow delete: if isSuperAdmin();
    }

    // Submissions (Phase 7): frozen snapshots. Students create/read their
    // own and can never touch grading fields; lecturers read all and update
    // grading fields only — the frozen payload stays immutable for both.
    match /submissions/{submissionId} {
      allow read: if signedIn()
        && (isLecturer() || resource.data.studentUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.submissionId == submissionId
        && request.resource.data.version is int
        && request.resource.data.version >= 1;
      allow update: if isLecturer()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['score', 'feedback', 'status', 'gradedAt', 'gradedByUid']);
      allow delete: if isSuperAdmin();
    }


    // Phase 8 hardening keeps the deny-by-default posture for anything new.
  }
}
