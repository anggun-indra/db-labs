rules_version = '2';

// Database Learning Lab — Firestore security rules (Phase 4).
// Principles (spec §28, §35, §39):
//  - Firebase UID is the canonical identity; no anonymous writes.
//  - Students own their projects: CRUD only on documents where
//    ownerUid == request.auth.uid.
//  - Roles are granted server-side: a client can only CREATE its own user
//    document with role 'student', and can never change the role field
//    afterwards (lecturer grants happen out-of-band in the console/API).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Roles are granted server-side (users/{uid}.role). This is the single
    // authoritative lecturer check used by courses/assignments/submissions.
    function isLecturer() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'lecturer';
    }

    match /users/{uid} {
      // A user may read and update their own profile, but the role field
      // is frozen after creation (server-side role enforcement).
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student';
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow read, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.projectId == projectId;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
    }

    // SQLite snapshots (Phase 5): metadata document + chunks subcollection.
    // Snapshots are immutable: create once, delete whole — never update.
    // Chunk access inherits ownership from the parent metadata document.
    match /sqliteSnapshots/{snapshotId} {
      allow read, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.snapshotId == snapshotId;
      allow update: if false;

      match /chunks/{chunkIndex} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/sqliteSnapshots/$(snapshotId))
               .data.ownerUid == request.auth.uid;
      }
    }

    // Courses (Phase 6): readable by any signed-in user, managed by lecturers.
    match /courses/{courseId} {
      allow read: if signedIn();
      allow create, update: if isLecturer()
        && request.resource.data.lecturerUid == request.auth.uid;
      allow delete: if isLecturer();
    }

    // Assignments (Phase 6): students read published only; lecturers manage
    // their own. Drafts/archived never leak to students because the read
    // rule requires status == 'published' for non-lecturers.
    match /assignments/{assignmentId} {
      allow read: if signedIn()
        && (isLecturer() || resource.data.status == 'published');
      allow create: if isLecturer()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.assignmentId == assignmentId;
      allow update, delete: if isLecturer()
        && resource.data.createdByUid == request.auth.uid;
    }

    // Phase 7 collections (submissions) get their rules added in that
    // phase; deny by default until then.
  }
}
